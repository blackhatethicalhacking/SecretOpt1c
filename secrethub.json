{
  "schema": 2,
  "name": "SecretHub",
  "description": "SecretOpt1c v2 detection engine \u2014 high-fidelity secret value patterns with entropy, severity and optional live validation. Written by Chris 'SaintDruG' Abou-Chabke / Black Hat Ethical Hacking.",
  "updated": "2026-10-09",
  "defaults": {
    "entropy": 0,
    "severity": "medium",
    "confidence": "high"
  },
  "rules": [
    {
      "id": "aws-access-key-id",
      "name": "AWS Access Key ID",
      "provider": "AWS",
      "severity": "critical",
      "confidence": "high",
      "regex": "\\b((?:A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16})\\b",
      "keywords": [
        "akia",
        "aws",
        "amazon"
      ],
      "references": [
        "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_identifiers.html"
      ]
    },
    {
      "id": "aws-secret-access-key",
      "name": "AWS Secret Access Key",
      "provider": "AWS",
      "severity": "critical",
      "confidence": "medium",
      "regex": "(?i)aws(.{0,20})?(secret|private)?[_.-]?(access)?[_.-]?key['\"\\s:=]{1,8}([A-Za-z0-9/+]{40})",
      "entropy": 4.2,
      "group": 4,
      "keywords": [
        "aws"
      ]
    },
    {
      "id": "aws-session-token",
      "name": "AWS Session Token",
      "provider": "AWS",
      "severity": "high",
      "confidence": "low",
      "regex": "(?i)aws_session_token['\"\\s:=]{1,8}([A-Za-z0-9/+=]{100,})",
      "group": 1,
      "entropy": 4.0,
      "keywords": [
        "aws_session_token"
      ]
    },
    {
